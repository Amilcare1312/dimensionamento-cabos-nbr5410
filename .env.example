# Copie para ".env" e preencha com os dados do seu projeto.
# Sem estas variáveis, o app roda em MODO LOCAL (dados só no navegador).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Stripe: ID do preço (price_...) da assinatura recorrente
VITE_STRIPE_PRICE_ID=price_xxx
